<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="camera_capture"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_camera"
        android:shortcutShortLabel="@string/shortcut_camera"
        android:shortcutLongLabel="@string/shortcut_camera">
        <intent
            android:action="com.armsone.imanagerai.action.CAMERA_CAPTURE"
            android:targetPackage="com.armsone.starmanager"
            android:targetClass="com.armsone.imanagerai.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="automation_start"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_automation"
        android:shortcutShortLabel="@string/shortcut_automation"
        android:shortcutLongLabel="@string/shortcut_automation">
        <intent
            android:action="com.armsone.imanagerai.action.AUTOMATION"
            android:targetPackage="com.armsone.starmanager"
            android:targetClass="com.armsone.imanagerai.MainActivity" />
    </shortcut>
</shortcuts>
